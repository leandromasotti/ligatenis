# Copiar a .env.local y completar con los valores del proyecto de Supabase
# (Project Settings → API). .env.local está en .gitignore: nunca se commitea.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio, usada para los metadatos y los mails de Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
